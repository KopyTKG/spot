[Unit]
Description=spot dialog daemon
Documentation=https://github.com/KopyTKG/spot/blob/main/docs/daemon.md
# Needs WAYLAND_DISPLAY, which the compositor (or uwsm) imports into the user
# manager before it reaches graphical-session.target.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/spot daemon
# --quit and a version upgrade end the daemon with status 0; those must not
# bring it back (the next `spot` call starts the new build on its own).
Restart=on-failure
RestartSec=1
Slice=app-graphical.slice

[Install]
WantedBy=graphical-session.target
