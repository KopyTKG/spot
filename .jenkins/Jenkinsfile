// Jenkins pipeline for spot. In the job, set Script Path to .jenkins/Jenkinsfile.
//
// - Lint, Test and Build run for every branch and pull request.
// - Publish, Release and AUR run only for a tag (v0.1.0 and so on). A tag build
//   skips Build: Publish compiles the same code in release mode.
// - AUR publishes both packages and commits the PKGBUILDs back to main
//   (ci/aur-release.sh). It needs the "SSH Username with private key" credential
//   `aur-ssh-key`, and `spot-github-token` must be allowed to push to main.
//
// The stages run in a container built from .jenkins/Dockerfile (Arch Linux with
// gtk4, gtk4-layer-shell, go, just and jq), so the agent only needs Docker, a
// user allowed to use it, and the Docker Pipeline plugin. Tag builds also need a
// "Secret text" credential `spot-github-token` with contents:write on
// KopyTKG/spot (not `github-token`: that one belongs to Sleepy and is scoped to
// that repo only).
//
// Compiling the gotk4 cgo bindings is the slow part (they build one after
// another, so extra CPUs don't help). The Go build and module caches therefore
// live in the Docker volume `spot-go-cache`, shared by every branch and tag: only
// the first build is cold.

pipeline {
    agent {
        dockerfile {
            dir '.jenkins'
            additionalBuildArgs '--pull'
            args '-v spot-go-cache:/cache'
        }
    }

    options {
        timestamps()
        disableConcurrentBuilds(abortPrevious: true)
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '5'))
    }

    environment {
        CGO_ENABLED = '1'
        GOFLAGS = '-buildvcs=false'
    }

    stages {
        stage('Lint') {
            steps {
                sh 'just lint'
            }
        }

        stage('Test') {
            steps {
                sh 'just test'
            }
        }

        stage('Build') {
            when { not { buildingTag() } }
            steps {
                sh 'just build'
            }
        }

        stage('Publish') {
            when { buildingTag() }
            steps {
                sh 'rm -rf dist && just package'
                archiveArtifacts artifacts: 'dist/spot-linux-x64', fingerprint: true
            }
        }

        stage('Release') {
            when { buildingTag() }
            steps {
                withCredentials([string(credentialsId: 'spot-github-token', variable: 'GH_TOKEN')]) {
                    sh 'ci/github-release.sh "$TAG_NAME" dist/spot-linux-x64'
                }
            }
        }

        stage('AUR') {
            when { buildingTag() }
            steps {
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'aur-ssh-key', keyFileVariable: 'AUR_KEY'),
                    string(credentialsId: 'spot-github-token', variable: 'GH_TOKEN'),
                ]) {
                    sh 'ci/aur-release.sh "$TAG_NAME"'
                }
            }
        }
    }
}
