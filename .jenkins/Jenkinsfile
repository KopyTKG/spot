// Jenkins pipeline for spot. In the job, set Script Path to .jenkins/Jenkinsfile.
//
// - Lint and Build run for every branch and pull request.
// - Publish and Release run only for a tag (v0.1.0 and so on).
//
// spot links gtk4 and gtk4-layer-shell through cgo, so the agent needs their
// development headers, installed from the distro (Debian: build-essential
// pkg-config libgtk-4-dev libgirepository1.0-dev libgtk4-layer-shell-dev), plus curl, git and mise on
// PATH. Go, just and jq come from mise.toml (an agent that already has the
// pinned Go installed reuses it). Tag builds also need a "Secret text"
// credential `github-token` with contents:write on KopyTKG/spot.

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds(abortPrevious: true)
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '5'))
    }

    environment {
        CGO_ENABLED = '1'
        GOFLAGS = '-buildvcs=false'
        GOCACHE = "${WORKSPACE}/.cache/go-build"
        GOPATH = "${WORKSPACE}/.cache/go"
    }

    stages {
        stage('Prepare') {
            steps {
                // Trust this checkout's mise.toml, then install what it pins.
                sh '''
                    mise trust --quiet "$WORKSPACE/mise.toml"
                    mise install
                '''
            }
        }

        stage('Toolchain') {
            steps {
                // cgo needs a C compiler and the gtk4 headers; fail with a clear
                // message instead of Go's "build constraints exclude all Go files".
                sh '''
                    command -v gcc >/dev/null || { echo "gcc missing: apt install build-essential"; exit 1; }
                    command -v pkg-config >/dev/null || { echo "pkg-config missing: apt install pkg-config"; exit 1; }
                    pkg-config --exists gtk4 || { echo "gtk4 headers missing: apt install libgtk-4-dev"; exit 1; }
                    pkg-config --exists gobject-introspection-1.0 || { echo "gobject-introspection headers missing: apt install libgirepository1.0-dev"; exit 1; }
                    pkg-config --exists gtk4-layer-shell-0 || { echo "gtk4-layer-shell headers missing: apt install libgtk4-layer-shell-dev"; exit 1; }
                '''
            }
        }

        stage('Lint') {
            steps {
                sh 'mise exec -- just lint'
            }
        }

        stage('Build') {
            steps {
                sh 'mise exec -- just build'
            }
        }

        stage('Publish') {
            when { buildingTag() }
            steps {
                sh 'rm -rf dist && mise exec -- just package'
                archiveArtifacts artifacts: 'dist/spot-linux-x64', fingerprint: true
            }
        }

        stage('Release') {
            when { buildingTag() }
            steps {
                withCredentials([string(credentialsId: 'github-token', variable: 'GH_TOKEN')]) {
                    sh 'mise exec -- ci/github-release.sh "$TAG_NAME" dist/spot-linux-x64'
                }
            }
        }
    }
}
